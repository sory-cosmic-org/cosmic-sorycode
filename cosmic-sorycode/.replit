modules = ["nodejs-20"]

[[ports]]
localPort = 4096

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start OpenCode"

[[workflows.workflow]]
name = "Start OpenCode"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/opencode && bun run --cwd packages/opencode --conditions=browser src/index.ts web --hostname 0.0.0.0 --port 5000 --print-logs"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
