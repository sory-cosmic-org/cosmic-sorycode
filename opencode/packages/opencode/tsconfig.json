{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    "noUncheckedIndexedAccess": false,
    "customConditions": ["browser"],
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"],
      // Local Preview: resolve the generated embedded web UI when running
      // from source. The file itself is produced by `bun run build`
      // (packages/app) plus the generator used for Replit previews.
      "opencode-web-ui.gen.ts": ["./opencode-web-ui.gen.ts"]
    }
  }
}
